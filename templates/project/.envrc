# Template direnv file for agent-friendly project environments.
# Copy into a project root as `.envrc`, then run: `direnv allow`

# Load a local virtual environment if present (without auto-creating one).
if [ -d .venv/bin ]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add .venv/bin
fi

# Optional project-local bin scripts.
PATH_add bin

# Example project variables (customize per project).
export PYTHONUNBUFFERED=1
